// Sistema Odontológico Integral - Prisma Schema
// Multi-tenant (clinic_id en casi todas las tablas)
// Enfocado en MVP: Auth + Pacientes + Agenda + Odontograma + Presupuestos básicos

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== MULTI-TENANT & AUTH ====================

model Clinic {
  id          String   @id @default(cuid())
  name        String
  ruc         String?  // Ecuador
  legalName   String?
  address     String?
  phone       String?
  email       String?
  logoUrl     String?
  plan        Plan     @default(BASIC)
  isActive    Boolean  @default(true)
  settings    Json?    // { noteLockHours, requireMfa, sri: { establecimiento, puntoEmision, ambiente } }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  patients      Patient[]
  rooms         Room[]
  appointments  Appointment[]
  procedures    Procedure[]
  treatmentPlans TreatmentPlan[]
  odontograms   Odontogram[]
  invoices      Invoice[]
  auditLogs     AuditLog[]

  @@map("clinics")
}

enum Plan {
  BASIC
  PRO
  ENTERPRISE
}

model User {
  id            String    @id @default(cuid())
  clinicId      String
  email         String
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(ASSISTANT)
  specialties   String[]  // para odontólogos
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  twoFactorSecret String?
  mfaEnabled    Boolean   @default(false) // RNF-05: TOTP verificado y activo
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clinic        Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments  Appointment[] @relation("DentistAppointments")
  clinicalNotes ClinicalNote[]
  createdByLogs AuditLog[] @relation("CreatedBy")

  @@unique([clinicId, email])
  @@index([clinicId])
  @@map("users")
}

enum Role {
  SUPERADMIN      // dueño del SaaS
  ADMIN           // administrador de clínica
  DENTIST         // odontólogo
  RECEPTIONIST    // recepcionista / cajero
  ASSISTANT       // asistente dental
  ACCOUNTANT      // contador / caja
  PATIENT         // portal paciente (futuro)
}

// ==================== PACIENTES ====================

model Patient {
  id              String    @id @default(cuid())
  clinicId        String
  documentType    String    @default("CEDULA") // CEDULA, PASAPORTE, RUC
  documentNumber  String
  firstName       String
  lastName        String
  birthDate       DateTime?
  gender          Gender?
  email           String?
  phone           String?
  address         String?
  city            String?
  occupation      String?
  emergencyContactName  String?
  emergencyContactPhone String?
  insuranceName   String?
  insuranceNumber String?
  photoUrl        String?
  tags            String[]
  isActive        Boolean   @default(true)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?

  clinic          Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  medicalHistory  MedicalHistory?
  guardians       Guardian[]
  appointments    Appointment[]
  odontograms     Odontogram[]
  treatmentPlans  TreatmentPlan[]
  clinicalNotes   ClinicalNote[]
  invoices        Invoice[]

  @@unique([clinicId, documentNumber])
  @@index([clinicId])
  @@index([clinicId, lastName, firstName])
  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

model Guardian {
  id            String  @id @default(cuid())
  patientId     String
  fullName      String
  documentNumber String?
  relationship  String  // padre, madre, tutor
  phone         String?
  email         String?

  patient       Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("guardians")
}

model MedicalHistory {
  id                String   @id @default(cuid())
  patientId         String   @unique
  allergies         String[] // ["penicilina", "látex"]
  medications       String[]
  systemicDiseases  String[] // diabetes, hipertensión, etc.
  surgicalHistory   String[] // RF-02: antecedentes quirúrgicos
  anticoagulated    Boolean  @default(false) // RF-02: paciente anticoagulado
  bleedingDisorder  Boolean  @default(false) // RF-02: coagulopatía
  habits            String[] // fumador, alcohol, etc.
  isPregnant        Boolean  @default(false)
  pregnancyWeeks    Int?
  bloodType         String?
  notes             String?
  alerts            String[] // alertas visibles: "ALERGIA PENICILINA"
  reviewedAt        DateTime?
  reviewedById      String?
  updatedAt         DateTime @updatedAt

  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_histories")
}

// ==================== AGENDA ====================

model Room {
  id          String   @id @default(cuid())
  clinicId    String
  name        String   // "Sillón 1", "Consultorio A"
  description String?
  isActive    Boolean  @default(true)

  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([clinicId])
  @@map("rooms")
}

model Appointment {
  id            String            @id @default(cuid())
  clinicId      String
  patientId     String
  dentistId     String
  roomId        String?
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus @default(SCHEDULED)
  reason        String?
  notes         String?
  isRecurring   Boolean           @default(false)
  procedureId   String?           // RF-14: procedimiento a realizar (descargo de insumos al completar)
  treatmentPlanItemId String?     // RF-08: ítem del presupuesto que originó la cita
  inventoryDischargedAt DateTime? // RF-14: evita descargar dos veces
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdById   String?

  clinic        Clinic            @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient           @relation(fields: [patientId], references: [id])
  dentist       User              @relation("DentistAppointments", fields: [dentistId], references: [id])
  room          Room?             @relation(fields: [roomId], references: [id])
  procedure     Procedure?        @relation(fields: [procedureId], references: [id])
  clinicalNotes ClinicalNote[]

  @@index([clinicId, startAt])
  @@index([dentistId, startAt])
  @@index([patientId])
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ==================== ODONTOGRAMA ====================

model Odontogram {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  version     Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  createdById String?

  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  teeth       ToothRecord[]

  @@index([patientId, version])
  @@map("odontograms")
}

model ToothRecord {
  id            String   @id @default(cuid())
  odontogramId  String
  toothNumber   Int      // FDI: 11-48 permanente, 51-85 temporal
  surface       ToothSurface? // null = todo el diente
  condition     ToothCondition
  status        TreatmentStatus @default(PENDING) // PENDING = rojo, DONE = azul
  notes         String?
  procedureId   String?  // vinculación a procedimiento del catálogo
  createdAt     DateTime @default(now())

  odontogram    Odontogram @relation(fields: [odontogramId], references: [id], onDelete: Cascade)

  @@index([odontogramId])
  @@map("tooth_records")
}

enum ToothSurface {
  V   // Vestibular / Bucal
  L   // Lingual / Palatino
  M   // Mesial
  D   // Distal
  O   // Oclusal
  I   // Incisal
}

enum ToothCondition {
  HEALTHY
  CARIES
  FILLING          // obturación
  ENDODONTICS
  CROWN
  BRIDGE
  IMPLANT
  MISSING          // ausente
  EXTRACTION_INDICATED
  FRACTURE
  SEALANT
  PROSTHESIS
  OTHER
}

enum TreatmentStatus {
  PENDING   // rojo
  DONE      // azul
  PLANNED
}

// ==================== PLAN DE TRATAMIENTO / PRESUPUESTOS ====================

model Procedure {
  id          String   @id @default(cuid())
  clinicId    String
  code        String?  // código interno o CIE
  name        String
  description String?
  category    String?  // operatoria, endodoncia, cirugía, etc.
  price       Decimal  @db.Decimal(10, 2)
  labCost     Decimal  @db.Decimal(10, 2) @default(0) // RF-07/RF-13: costo de laboratorio
  durationMin Int?     // duración estimada en minutos
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  planItems   TreatmentPlanItem[]
  consumptions ProcedureConsumption[]
  appointments Appointment[]

  @@index([clinicId])
  @@map("procedures")
}

model TreatmentPlan {
  id            String              @id @default(cuid())
  clinicId      String
  patientId     String
  title         String?
  status        TreatmentPlanStatus @default(DRAFT)
  totalAmount   Decimal             @db.Decimal(12, 2) @default(0)
  discount      Decimal             @db.Decimal(12, 2) @default(0)
  notes         String?
  approvedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdById   String?

  clinic        Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient             @relation(fields: [patientId], references: [id])
  items         TreatmentPlanItem[]

  @@index([clinicId, patientId])
  @@map("treatment_plans")
}

enum TreatmentPlanStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model TreatmentPlanItem {
  id              String   @id @default(cuid())
  treatmentPlanId String
  procedureId     String
  toothNumber     Int?
  surface         ToothSurface?
  quantity        Int      @default(1)
  unitPrice       Decimal  @db.Decimal(10, 2)
  labCost         Decimal  @db.Decimal(10, 2) @default(0)
  discount        Decimal  @db.Decimal(10, 2) @default(0)
  status          TreatmentStatus @default(PENDING)
  approved        Boolean  @default(false) // RF-08: aprobación parcial por ítem
  phase           Int?     // fase/etapa del plan
  notes           String?

  treatmentPlan   TreatmentPlan @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  procedure       Procedure     @relation(fields: [procedureId], references: [id])

  @@map("treatment_plan_items")
}

// ==================== HISTORIA CLÍNICA (notas) ====================

model ClinicalNote {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  appointmentId String?
  authorId      String
  noteType      String   @default("SOAP") // SOAP, EVOLUTION, ADDENDUM
  parentNoteId  String?  // RN-01: adenda que corrige una nota firmada
  subjective    String?  // S
  objective     String?  // O
  assessment    String?  // A
  plan          String?  // P
  content       String?  // nota libre
  isLocked      Boolean  @default(false) // inmutable una vez firmada
  signedAt      DateTime?
  signatureHash String?  // RF-05: SHA-256 del contenido + autor + fecha de firma
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  patient       Patient      @relation(fields: [patientId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  author        User         @relation(fields: [authorId], references: [id])

  @@index([patientId])
  @@map("clinical_notes")
}

// ==================== FACTURACIÓN BÁSICA (MVP) ====================

model Invoice {
  id            String        @id @default(cuid())
  clinicId      String
  patientId     String
  number        String?       // número de factura
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(12, 2)
  tax           Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @db.Decimal(12, 2) @default(0)
  notes         String?
  sriAccessKey  String?       // RF-12: clave de acceso (49 dígitos)
  sriStatus     String?       // PENDIENTE_FIRMA, RECIBIDA, AUTORIZADA, DEVUELTA
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient       @relation(fields: [patientId], references: [id])
  items         InvoiceItem[]
  payments      Payment[]

  @@unique([clinicId, number])
  @@index([clinicId])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
  CREDIT_NOTE
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  amount      Decimal       @db.Decimal(12, 2)
  method      PaymentMethod
  reference   String?       // número de transferencia, etc.
  paidAt      DateTime      @default(now())
  notes       String?

  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  INSURANCE  // seguro / convenio
  OTHER
}

// ==================== AUDITORÍA ====================

model AuditLog {
  id          String   @id @default(cuid())
  clinicId    String?
  userId      String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, VIEW
  entity      String   // Patient, Appointment, etc.
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  clinic      Clinic?  @relation(fields: [clinicId], references: [id])
  user        User?    @relation("CreatedBy", fields: [userId], references: [id])

  @@index([clinicId, createdAt])
  @@map("audit_logs")
}

// ==================== PERIODONTOGRAMA (RF-04) ====================

model Periodontogram {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  version     Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())
  createdById String?

  sites       PeriodontalSite[]

  @@index([patientId, version])
  @@map("periodontograms")
}

model PeriodontalSite {
  id               String  @id @default(cuid())
  periodontogramId String
  toothNumber      Int
  // 6 puntos: MB, B, DB, ML, L, DL
  probingDepths    Int[]   // mm
  gingivalMargin   Int[]   // mm
  clinicalAttachment Int[] // NIC calculado
  bleeding         Boolean[] @default([])
  mobility         Int?    // 0-3
  furcation        Int?    // 0-3
  notes            String?

  periodontogram   Periodontogram @relation(fields: [periodontogramId], references: [id], onDelete: Cascade)

  @@index([periodontogramId])
  @@map("periodontal_sites")
}

// ==================== CONSENTIMIENTOS (RF-06) ====================

model ConsentTemplate {
  id          String   @id @default(cuid())
  clinicId    String
  name        String
  procedureCode String?
  bodyHtml    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  consents    Consent[]

  @@map("consent_templates")
}

model Consent {
  id            String   @id @default(cuid())
  clinicId      String
  patientId     String
  templateId    String?
  title         String
  contentSnapshot String
  signedAt      DateTime?
  signatureData String?  // base64 o hash
  otpVerified   Boolean  @default(false)
  otpHash       String?  // RF-06: hash del código OTP enviado al paciente
  otpExpiresAt  DateTime?
  status        String   @default("PENDING") // PENDING, SIGNED, REVOKED
  createdAt     DateTime @default(now())
  createdById   String?

  template      ConsentTemplate? @relation(fields: [templateId], references: [id])

  @@index([patientId])
  @@map("consents")
}

// ==================== INVENTARIO (RF-14) ====================

model Product {
  id            String   @id @default(cuid())
  clinicId      String
  sku           String?
  name          String
  unit          String   @default("UND")
  stock         Decimal  @db.Decimal(12, 2) @default(0)
  minStock      Decimal  @db.Decimal(12, 2) @default(0)
  unitCost      Decimal  @db.Decimal(12, 2) @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  movements     StockMovement[]
  consumptions  ProcedureConsumption[]

  @@index([clinicId])
  @@map("products")
}

model StockMovement {
  id          String   @id @default(cuid())
  clinicId    String
  productId   String
  type        String   // IN, OUT, ADJUST
  quantity    Decimal  @db.Decimal(12, 2)
  reason      String?
  referenceId String?  // appointmentId / purchaseId
  createdAt   DateTime @default(now())
  createdById String?

  product     Product  @relation(fields: [productId], references: [id])

  @@map("stock_movements")
}

model ProcedureConsumption {
  id          String  @id @default(cuid())
  procedureId String
  productId   String
  quantity    Decimal @db.Decimal(12, 2)

  product     Product   @relation(fields: [productId], references: [id])
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@map("procedure_consumptions")
}

// ==================== NOTIFICACIONES (RF-11 placeholder) ====================

model MessageTemplate {
  id        String   @id @default(cuid())
  clinicId  String
  channel   String   // WHATSAPP, SMS, EMAIL
  eventType String   // REMINDER_24H, REMINDER_48H, BIRTHDAY, etc.
  subject   String?
  body      String
  isActive  Boolean  @default(true)

  @@map("message_templates")
}

model NotificationLog {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String?
  channel     String
  eventType   String?  // REMINDER_48H, REMINDER_24H, CONFIRMATION, CONSENT_OTP...
  appointmentId String?
  toAddress   String
  body        String
  status      String   @default("PENDING") // PENDING, SENT, FAILED
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([clinicId, createdAt])
  @@index([appointmentId, eventType])
  @@map("notification_logs")
}

// ==================== RECETAS (Fase 2) ====================

model Prescription {
  id          String   @id @default(cuid())
  clinicId    String
  patientId   String
  dentistId   String?
  appointmentId String?
  diagnosis   String?
  indications String?
  items       Json     // [{ medication, dose, frequency, duration, notes }]
  isSigned    Boolean  @default(false)
  signedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
  @@index([clinicId])
  @@map("prescriptions")
}

// ==================== FASE 3: COMISIONES Y CIERRES ====================

model CommissionRule {
  id            String   @id @default(cuid())
  clinicId      String
  name          String
  // PERCENT_GROSS | PERCENT_AFTER_COST | FIXED_AMOUNT
  type          String   @default("PERCENT_GROSS")
  value         Decimal  @db.Decimal(10, 4) // % o monto fijo
  procedureId   String?  // null = aplica a todos
  dentistId     String?  // null = aplica a todos los odontólogos
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clinicId])
  @@map("commission_rules")
}

model CashClose {
  id              String   @id @default(cuid())
  clinicId        String
  closeDate       DateTime // día del cierre
  // RN-02: primero se ingresa el conteo físico (ciego)
  physicalCash    Decimal  @db.Decimal(12, 2)
  physicalCard    Decimal  @db.Decimal(12, 2) @default(0)
  physicalTransfer Decimal @db.Decimal(12, 2) @default(0)
  // luego el sistema calcula teórico y diferencia
  theoreticalCash Decimal  @db.Decimal(12, 2)
  theoreticalCard Decimal  @db.Decimal(12, 2)
  theoreticalTransfer Decimal @db.Decimal(12, 2)
  differenceCash  Decimal  @db.Decimal(12, 2)
  notes           String?
  closedById      String?
  createdAt       DateTime @default(now())

  @@index([clinicId, closeDate])
  @@map("cash_closes")
}
