# ==================== Base de datos ====================
# Neon / Railway / local. Con Docker:  postgresql://sigo:sigo@localhost:5432/sigo_dental
DATABASE_URL="postgresql://user:password@host:5432/dental?sslmode=require"

# ==================== Seguridad (RNF-04 / RNF-05) ====================
# En producción: mínimo 32 caracteres aleatorios
JWT_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio-de-32+"
# Vigencia del token (el cierre por inactividad de 15 min lo aplica el frontend)
JWT_EXPIRES_IN=8h
# CORS: dominio(s) del frontend separados por coma. "true" = cualquiera (solo desarrollo)
CORS_ORIGIN=http://localhost:3000
PORT=3001
NODE_ENV=development
# % máximo de descuento sin autorización de un administrador (RF-07)
MAX_DISCOUNT_PCT_WITHOUT_ADMIN=10

# ==================== Zona horaria de la clínica ====================
CLINIC_TIMEZONE=America/Guayaquil
CLINIC_UTC_OFFSET=-5

# ==================== Notificaciones (RF-11) ====================
# Sin credenciales se usa el modo prueba (los mensajes se registran pero no salen).
NOTIFICATIONS_SCHEDULER=on
NOTIFICATIONS_INTERVAL_MIN=10
# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Email (Twilio SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM=
